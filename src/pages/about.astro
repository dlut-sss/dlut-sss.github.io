---
import Layout from "../layouts/Layout.astro";

const values = [
  { index: "01", title: "保持好奇", en: "STAY CURIOUS", text: "对系统、协议和每一个异常现象保持追问，在看似确定的边界里寻找新的可能。" },
  { index: "02", title: "深度实践", en: "LEARN BY DOING", text: "不止于理解概念。通过竞赛、复现、研究和分享，把知识转化为真正的攻防能力。" },
  { index: "03", title: "开放协作", en: "SHARE OPENLY", text: "相信知识在交流中生长。尊重不同方向，让每个人的独特视角成为团队的一部分。" },
];
---

<Layout title="关于我们" description="了解 Scr1w Studio：大连理工大学学生网络安全团队的使命、方向与文化。">
  <section class="page-hero shell about-hero">
    <span class="eyebrow">Who We Are</span>
    <h1>一群认真探索<br /><span>安全边界</span>的人</h1>
    <p>Scr1w Studio 成立于 2018 年，是大连理工大学学生网络安全团队。我们因共同的好奇心聚在一起，在竞赛、研究与分享中持续成长。</p>
  </section>

  <section class="identity shell">
    <div class="identity-statement">
      <span class="section-number">/ 01 — IDENTITY</span>
      <p>我们不把网络安全理解成一组固定答案。</p>
      <p class="muted">它是一种看待复杂系统的方式：拆解、验证、质疑，然后构建得更好。</p>
    </div>
    <aside class="identity-card">
      <div class="id-top"><span>TEAM PROFILE</span><i></i></div>
      <dl>
        <div><dt>NAME</dt><dd>SCR1W STUDIO</dd></div>
        <div><dt>FOUNDED</dt><dd>2018</dd></div>
        <div><dt>BASE</dt><dd>DLUT · DALIAN</dd></div>
        <div><dt>TYPE</dt><dd>STUDENT CYBERSECURITY TEAM</dd></div>
        <div><dt>STATUS</dt><dd class="online">● ACTIVE</dd></div>
      </dl>
    </aside>
  </section>

  <section class="what-we-do shell">
    <div class="section-head">
      <div><span class="eyebrow">How We Operate</span><h2>竞赛、研究、分享</h2></div>
      <p>把输入变成实践，把实践沉淀为知识，再让知识推动下一次探索。</p>
    </div>
    <div class="operation-grid">
      <article><span>01</span><div class="op-symbol">FLAG</div><h3>CTF 竞赛</h3><p>在高强度对抗环境中训练分析、协作与快速学习能力，覆盖 Web、Pwn、Reverse、Crypto、Misc 等方向。</p></article>
      <article><span>02</span><div class="op-symbol">LAB</div><h3>安全研究</h3><p>围绕漏洞原理、系统机制与前沿技术开展复现和探索，把比赛之外的问题带回实验室。</p></article>
      <article><span>03</span><div class="op-symbol">OPEN</div><h3>技术分享</h3><p>通过 Writeup、内部交流与开放文档记录真实思考过程，让经验可以被检索、讨论和继续推进。</p></article>
    </div>
  </section>

  <section class="values shell">
    <span class="section-number">/ 03 — OUR VALUES</span>
    <div class="value-list">
      {values.map((value) => (
        <article>
          <span>{value.index}</span>
          <div><small>{value.en}</small><h3>{value.title}</h3></div>
          <p>{value.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="manifesto shell">
    <div class="manifesto-code">SCR1W://MANIFESTO</div>
    <blockquote>“我们拆解系统，不是为了制造混乱，<br />而是为了理解它，并让它变得更可靠。”</blockquote>
    <div class="manifesto-foot"><span>HACK WITH CURIOSITY</span><span>BUILD WITH RESPONSIBILITY</span></div>
  </section>

  <section class="about-cta shell">
    <div><span class="eyebrow">Keep In Touch</span><h2>继续了解我们的技术与行动</h2><p>查看团队知识库，或从最新的技术复盘开始。</p></div>
    <div><a class="button-primary" href="https://dlut-sss.feishu.cn/wiki/wikcnqNsxlIkiKNoH1chS0K0HEc">访问团队 Wiki <span>↗</span></a><a class="button-secondary" href="/blog">阅读 Writeups <span>→</span></a></div>
  </section>
</Layout>

<style>
  .about-hero h1 span { color: var(--green); }
  .identity { padding-top: 88px; display: grid; grid-template-columns: 1.2fr .8fr; gap: 90px; }
  .section-number { color: #667b98; font-family: var(--mono); font-size: .62rem; letter-spacing: .12em; }
  .identity-statement > p { max-width: 650px; margin: 42px 0 0; font-size: clamp(1.7rem, 4vw, 3.3rem); font-weight: 700; line-height: 1.2; letter-spacing: -.045em; }
  .identity-statement .muted { margin-top: 20px; color: var(--muted); font-size: clamp(1.15rem, 2vw, 1.55rem); font-weight: 400; line-height: 1.5; }
  .identity-card { border: 1px solid var(--line-strong); background: rgba(10,17,31,.78); }
  .id-top { padding: 12px 16px; display: flex; justify-content: space-between; border-bottom: 1px solid var(--line); color: #687e9b; font-family: var(--mono); font-size: .58rem; letter-spacing: .1em; }
  .id-top i { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px var(--green); }
  .identity-card dl { margin: 0; padding: 12px 20px 20px; }
  .identity-card dl div { padding: 15px 0; display: grid; grid-template-columns: 88px 1fr; border-bottom: 1px solid var(--line); font-family: var(--mono); }
  .identity-card dl div:last-child { border: 0; }
  .identity-card dt { color: #5e7390; font-size: .56rem; letter-spacing: .1em; }
  .identity-card dd { margin: 0; color: #cad9e8; font-size: .66rem; text-align: right; }
  .identity-card dd.online { color: var(--green); }
  .what-we-do { padding-top: 130px; }
  .operation-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line-strong); border-left: 1px solid var(--line-strong); }
  .operation-grid article { min-height: 390px; position: relative; padding: 26px; border-right: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); background: rgba(9,16,29,.5); }
  .operation-grid article > span { color: #5c7290; font-family: var(--mono); font-size: .62rem; }
  .op-symbol { width: 82px; height: 82px; margin-top: 48px; display: grid; place-items: center; border: 1px solid var(--line-strong); color: var(--green); font-family: var(--mono); font-size: .76rem; }
  .operation-grid h3 { margin: 30px 0 12px; font-size: 1.25rem; }
  .operation-grid p { margin: 0; color: var(--muted); font-size: .86rem; }
  .values { padding-top: 130px; }
  .value-list { margin-top: 24px; border-top: 1px solid var(--line-strong); }
  .value-list article { min-height: 150px; display: grid; grid-template-columns: 80px 260px 1fr; align-items: center; gap: 30px; border-bottom: 1px solid var(--line-strong); }
  .value-list article > span { color: var(--green); font-family: var(--mono); }
  .value-list small { color: #687d99; font-family: var(--mono); font-size: .55rem; letter-spacing: .12em; }
  .value-list h3 { margin: 4px 0 0; font-size: 1.4rem; }
  .value-list p { max-width: 560px; margin: 0; color: var(--muted); font-size: .88rem; }
  .manifesto { margin-top: 130px; padding: 62px; border: 1px solid var(--line-strong); background: radial-gradient(circle at 80% 20%, rgba(63,60,146,.28), transparent 28rem), rgba(9,16,31,.82); clip-path: polygon(0 0, calc(100% - 34px) 0, 100% 34px, 100% 100%, 0 100%); }
  .manifesto-code { color: var(--green); font-family: var(--mono); font-size: .65rem; letter-spacing: .15em; }
  .manifesto blockquote { margin: 48px 0; font-size: clamp(1.8rem, 4.5vw, 4.3rem); font-weight: 800; line-height: 1.2; letter-spacing: -.05em; }
  .manifesto-foot { display: flex; justify-content: space-between; gap: 20px; padding-top: 18px; border-top: 1px solid var(--line); color: #6b809c; font-family: var(--mono); font-size: .6rem; letter-spacing: .1em; }
  .about-cta { padding-top: 110px; display: flex; align-items: end; justify-content: space-between; gap: 50px; }
  .about-cta h2 { margin: 12px 0 8px; font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -.045em; }
  .about-cta p { margin: 0; color: var(--muted); }
  .about-cta > div:last-child { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 850px) { .identity { grid-template-columns: 1fr; gap: 50px; } .operation-grid { grid-template-columns: 1fr; } .operation-grid article { min-height: 320px; } .value-list article { grid-template-columns: 50px 1fr; padding-block: 26px; } .value-list p { grid-column: 2; } .about-cta { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 560px) { .identity, .what-we-do, .values { padding-top: 88px; } .manifesto { margin-top: 90px; padding: 36px 22px; } .manifesto-foot { align-items: flex-start; flex-direction: column; } .about-cta > div:last-child, .about-cta a { width: 100%; } }
</style>
