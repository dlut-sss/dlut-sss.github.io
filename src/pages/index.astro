---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const allPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const posts = allPosts.slice(0, 4);

const formatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

const researchAreas = [
  { code: "01", icon: "</>", title: "Web Security", text: "漏洞挖掘、服务端攻防、现代 Web 安全与真实场景分析。", tags: ["PWN THE WEB", "AUDIT"] },
  { code: "02", icon: "0x", title: "Binary Security", text: "逆向工程、二进制漏洞利用、系统安全与底层机制研究。", tags: ["REVERSE", "PWN"] },
  { code: "03", icon: "#?", title: "Crypto & Misc", text: "密码分析、取证、隐写与跨学科安全问题的探索和实践。", tags: ["CRYPTO", "FORENSICS"] },
  { code: "04", icon: "AI", title: "AI Security", text: "关注人工智能系统安全、模型攻防与新兴安全技术边界。", tags: ["AI SAFETY", "FRONTIER"] },
];
---

<Layout>
  <section class="home-hero shell">
    <div class="hero-copy">
      <div class="live-badge"><span></span> DLUT · EST. 2018 · ONLINE</div>
      <h1>
        <span>BREAK THINGS.</span>
        <span class="outline">BUILD BETTER.</span>
      </h1>
      <p>
        我们是 <strong>Scr1w Studio</strong>，来自大连理工大学的学生网络安全团队。以 CTF
        为赛场，以真实攻防为方法，持续探索系统的边界。
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="#research">探索研究方向 <span>↓</span></a>
        <a class="button-secondary" href="/blog">阅读技术文章 <span>↗</span></a>
      </div>
      <div class="hero-meta">
        <div><span>FOCUS</span><strong>CTF / RESEARCH</strong></div>
        <div><span>LOCATION</span><strong>DALIAN, CN</strong></div>
      </div>
    </div>

    <div class="hero-visual" aria-label="Scr1w 网络安全终端视觉">
      <div class="visual-glow"></div>
      <div class="terminal-card">
        <div class="terminal-top">
          <span><i></i><i></i><i></i></span>
          <b>scr1w@dlut:~/lab</b>
          <em>SECURE</em>
        </div>
        <div class="terminal-body">
          <div class="terminal-copy">
            <p><span>➜</span> ./identify --team</p>
            <p class="output">SCR1W_STUDIO</p>
            <p><span>➜</span> cat mission.txt</p>
            <p class="output typing">hack · learn · share · repeat<span class="cursor">_</span></p>
          </div>
          <div class="logo-core">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="core-ring">
              <img src="/favicon.png" alt="Scr1w Studio 标志" width="260" height="260" />
            </div>
            <span class="node node-a">01</span>
            <span class="node node-b">FF</span>
            <span class="node node-c">0X</span>
          </div>
        </div>
        <div class="terminal-status">
          <span>NODE 38.8822°N / 121.5297°E</span>
          <span><i></i> ENCRYPTED</span>
        </div>
      </div>
    </div>
  </section>

  <div class="signal-strip" aria-hidden="true">
    <div>
      <span>OFFENSIVE SECURITY</span><i>✦</i><span>CTF COMPETITION</span><i>✦</i><span>VULNERABILITY RESEARCH</span><i>✦</i><span>OPEN KNOWLEDGE</span><i>✦</i><span>OFFENSIVE SECURITY</span><i>✦</i><span>CTF COMPETITION</span>
    </div>
  </div>

  <section class="stats shell" aria-label="团队数据">
    <div><strong>2018</strong><span>团队成立</span></div>
    <div><strong>17+</strong><span>赛事荣誉</span></div>
    <div><strong>{allPosts.length}</strong><span>公开 Writeups</span></div>
    <div><strong>4</strong><span>核心研究方向</span></div>
  </section>

  <section id="research" class="research-section shell">
    <div class="section-head">
      <div>
        <span class="eyebrow">Research Matrix</span>
        <h2>向未知处进攻</h2>
      </div>
      <p>从应用层到系统底层，从经典密码学到 AI 安全，我们通过竞赛与研究建立可复用的攻防能力。</p>
    </div>
    <div class="research-grid">
      {researchAreas.map((area) => (
        <article class="research-card">
          <div class="card-index">/{area.code}</div>
          <div class="card-icon">{area.icon}</div>
          <h3>{area.title}</h3>
          <p>{area.text}</p>
          <div class="tag-row">{area.tags.map((tag) => <span>{tag}</span>)}</div>
          <div class="card-corner" aria-hidden="true"></div>
        </article>
      ))}
    </div>
  </section>

  <section class="latest-section shell">
    <div class="section-head">
      <div>
        <span class="eyebrow">Latest Intelligence</span>
        <h2>最新技术复盘</h2>
      </div>
      <a class="text-link" href="/blog">浏览全部文章 <span>→</span></a>
    </div>
    <div class="post-grid">
      {posts.map((post, index) => (
        <a class:list={["post-card", { featured: index === 0 }]} href={`/blog/${post.id}`}>
          <div class="post-top">
            <span>WRITEUP_{String(index + 1).padStart(2, "0")}</span>
            <time datetime={post.data.date.toISOString()}>{formatter.format(post.data.date)}</time>
          </div>
          <div class="post-content">
            <span class="post-kicker">CTF / AFTER ACTION REPORT</span>
            <h3>{post.data.title}</h3>
            <p>完整记录赛题分析、攻击路径与解题思路，沉淀可复用的安全知识。</p>
          </div>
          <div class="post-bottom"><span>READ REPORT</span><b>↗</b></div>
        </a>
      ))}
    </div>
  </section>

  <section class="achievement-section shell">
    <div class="achievement-main">
      <span class="eyebrow">Field Record</span>
      <h2>在真实对抗中<br />验证每一次成长</h2>
      <p>持续参与全国及国际网络安全赛事，用高强度对抗检验技术，用公开复盘推动社区共同进步。</p>
      <a class="button-secondary" href="/awards">查看完整荣誉墙 <span>→</span></a>
    </div>
    <div class="achievement-list">
      <div><span class="rank">02</span><div><b>NCTF 2022</b><p>全国总决赛 · 亚军</p></div><em>2022</em></div>
      <div><span class="rank">03</span><div><b>XCTF 国际网络攻防联赛</b><p>总决赛团队赛 · 三等奖</p></div><em>2025</em></div>
      <div><span class="rank">03</span><div><b>全国大学生人工智能安全竞赛</b><p>全国赛 · 三等奖</p></div><em>2025</em></div>
    </div>
  </section>

  <section class="cta-section shell">
    <div>
      <span class="eyebrow">Join The Signal</span>
      <h2>好奇心，是最好的漏洞扫描器。</h2>
      <p>保持怀疑，持续学习，一起寻找技术世界里还没有答案的问题。</p>
    </div>
    <a class="button-primary" href="/about">了解 Scr1w <span>↗</span></a>
  </section>
</Layout>

<style>
  .home-hero { min-height: 760px; display: grid; grid-template-columns: 1.02fr 0.98fr; align-items: center; gap: 56px; padding-block: 88px 72px; }
  .live-badge { width: fit-content; display: inline-flex; align-items: center; gap: 9px; padding: 7px 10px; border: 1px solid var(--line-strong); background: rgba(139,188,255,.045); color: var(--muted); font-family: var(--mono); font-size: .65rem; letter-spacing: .13em; }
  .live-badge span { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 12px var(--green); animation: pulse 1.8s ease-in-out infinite; }
  .hero-copy h1 { margin: 28px 0 24px; font-family: var(--mono); font-size: clamp(3.35rem, 6.6vw, 6.5rem); line-height: .88; letter-spacing: -.075em; }
  .hero-copy h1 span { display: block; }
  .hero-copy .outline { margin-top: 14px; color: transparent; -webkit-text-stroke: 1px rgba(214,233,248,.58); }
  .hero-copy > p { max-width: 590px; margin: 0; color: var(--muted); font-size: 1.02rem; }
  .hero-copy > p strong { color: var(--green); }
  .hero-actions { margin-top: 34px; display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-meta { margin-top: 52px; display: flex; gap: 54px; }
  .hero-meta div { display: grid; gap: 4px; }
  .hero-meta span { color: #657b99; font-family: var(--mono); font-size: .62rem; letter-spacing: .17em; }
  .hero-meta strong { font-family: var(--mono); font-size: .75rem; letter-spacing: .06em; }

  .hero-visual { position: relative; min-width: 0; }
  .visual-glow { position: absolute; inset: 10%; border-radius: 50%; background: rgba(63,60,146,.26); filter: blur(80px); }
  .terminal-card { position: relative; overflow: hidden; border: 1px solid var(--line-strong); background: linear-gradient(145deg, rgba(12,20,36,.96), rgba(4,8,16,.98)); box-shadow: 0 35px 90px rgba(0,0,0,.45); clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 0 100%); }
  .terminal-card::before { position: absolute; inset: 0; background: repeating-linear-gradient(to bottom, transparent 0 3px, rgba(139,188,255,.022) 4px); content: ""; pointer-events: none; }
  .terminal-top { height: 46px; padding: 0 16px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid var(--line); color: #6b7f9c; font-family: var(--mono); font-size: .6rem; }
  .terminal-top > span { display: flex; gap: 5px; }
  .terminal-top i { width: 6px; height: 6px; border-radius: 50%; background: #3f506b; }
  .terminal-top b { font-weight: 500; }
  .terminal-top em { justify-self: end; color: var(--green); font-style: normal; }
  .terminal-body { min-height: 520px; position: relative; padding: 26px; }
  .terminal-copy { position: relative; z-index: 2; color: #8299b8; font-family: var(--mono); font-size: .7rem; }
  .terminal-copy p { margin: 0 0 7px; }
  .terminal-copy p span { color: var(--green); }
  .terminal-copy .output { padding-left: 20px; color: #c7d8e6; }
  .terminal-copy .typing { color: var(--cyan); }
  .cursor { animation: blink 1s steps(1) infinite; }
  .logo-core { position: absolute; right: 50%; bottom: 46%; width: 310px; height: 310px; transform: translate(50%, 50%); display: grid; place-items: center; }
  .core-ring { width: 218px; height: 218px; display: grid; place-items: center; border: 1px solid rgba(139,188,255,.3); border-radius: 50%; background: radial-gradient(circle, rgba(63,60,146,.22), rgba(139,188,255,.025) 66%); box-shadow: inset 0 0 55px rgba(139,188,255,.08), 0 0 60px rgba(95,129,216,.12); }
  .core-ring img { width: 174px; height: 174px; object-fit: contain; filter: drop-shadow(0 14px 28px rgba(0,0,0,.4)); animation: hover 5s ease-in-out infinite; }
  .orbit { position: absolute; inset: 18px; border: 1px dashed rgba(139,188,255,.3); border-radius: 50%; animation: spin 24s linear infinite; }
  .orbit::before, .orbit::after { position: absolute; width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 12px var(--green); content: ""; }
  .orbit::before { top: 20px; left: 55px; }
  .orbit::after { right: 24px; bottom: 46px; }
  .orbit-two { inset: 52px; border-style: solid; border-color: rgba(214,233,248,.18); animation-direction: reverse; animation-duration: 17s; }
  .node { position: absolute; padding: 3px 6px; border: 1px solid var(--line); background: #080d18; color: var(--green); font-family: var(--mono); font-size: .55rem; }
  .node-a { top: 18px; right: 55px; } .node-b { right: 3px; bottom: 95px; } .node-c { bottom: 20px; left: 58px; }
  .terminal-status { min-height: 40px; padding: 0 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line); color: #607592; font-family: var(--mono); font-size: .56rem; letter-spacing: .06em; }
  .terminal-status span:last-child { display: inline-flex; align-items: center; gap: 7px; color: var(--green); }
  .terminal-status i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  .signal-strip { overflow: hidden; border-block: 1px solid var(--line-strong); background: var(--green); color: #050914; transform: rotate(-.45deg) scale(1.01); }
  .signal-strip div { width: max-content; padding: 10px 0; display: flex; align-items: center; gap: 28px; font-family: var(--mono); font-size: .68rem; font-weight: 900; letter-spacing: .13em; animation: marquee 30s linear infinite; }

  .stats { margin-top: 88px; display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--line); }
  .stats div { padding: 30px 26px; display: flex; align-items: baseline; gap: 12px; border-right: 1px solid var(--line); }
  .stats div:last-child { border: 0; }
  .stats strong { font-family: var(--mono); font-size: clamp(1.7rem, 4vw, 2.8rem); line-height: 1; }
  .stats span { color: var(--muted); font-size: .78rem; }

  .research-section, .latest-section, .achievement-section { padding-top: 120px; }
  .research-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-strong); border-left: 1px solid var(--line-strong); }
  .research-card { min-height: 370px; position: relative; padding: 26px; overflow: hidden; border-right: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); background: linear-gradient(150deg, rgba(13,23,40,.72), rgba(5,9,17,.48)); transition: 220ms ease; }
  .research-card:hover { z-index: 2; transform: translateY(-5px); border-color: rgba(139,188,255,.62); background: linear-gradient(150deg, rgba(24,38,72,.94), rgba(6,10,20,.76)); box-shadow: 0 26px 60px rgba(0,0,0,.28); }
  .card-index { color: #607794; font-family: var(--mono); font-size: .65rem; }
  .card-icon { width: 70px; height: 70px; margin-top: 38px; display: grid; place-items: center; border: 1px solid var(--line-strong); color: var(--green); font-family: var(--mono); font-size: 1.25rem; transition: 220ms ease; }
  .research-card:hover .card-icon { background: var(--green); color: #050914; }
  .research-card h3 { margin: 26px 0 10px; font-family: var(--mono); font-size: 1.08rem; }
  .research-card p { margin: 0; color: var(--muted); font-size: .84rem; }
  .tag-row { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 6px; }
  .tag-row span { padding: 3px 6px; border: 1px solid var(--line); color: #748aa7; font-family: var(--mono); font-size: .52rem; }
  .card-corner { position: absolute; right: 0; bottom: 0; width: 22px; height: 22px; border-top: 1px solid var(--line-strong); border-left: 1px solid var(--line-strong); }

  .text-link { color: var(--green); font-family: var(--mono); font-size: .75rem; }
  .text-link span { margin-left: 8px; }
  .post-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .post-card { min-height: 270px; padding: 22px; display: flex; flex-direction: column; border: 1px solid var(--line); background: rgba(9,16,29,.65); transition: 200ms ease; }
  .post-card:hover { transform: translateY(-4px); border-color: var(--line-strong); background: rgba(15,25,46,.92); }
  .post-card.featured { background: linear-gradient(135deg, rgba(37,50,96,.92), rgba(8,13,25,.88)); }
  .post-top, .post-bottom { display: flex; align-items: center; justify-content: space-between; color: #687e9c; font-family: var(--mono); font-size: .6rem; letter-spacing: .08em; }
  .post-content { margin-block: auto; padding-block: 28px; }
  .post-kicker { color: var(--green); font-family: var(--mono); font-size: .58rem; letter-spacing: .1em; }
  .post-content h3 { margin: 9px 0 8px; font-family: var(--mono); font-size: clamp(1.45rem, 3vw, 2.4rem); letter-spacing: -.04em; }
  .post-content p { max-width: 480px; margin: 0; color: var(--muted); font-size: .82rem; }
  .post-bottom { padding-top: 15px; border-top: 1px solid var(--line); color: var(--text); }
  .post-bottom b { color: var(--green); font-size: 1.1rem; }

  .achievement-section { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; }
  .achievement-main h2 { margin: 14px 0 20px; font-size: clamp(2.2rem, 4vw, 3.8rem); line-height: 1.08; letter-spacing: -.045em; }
  .achievement-main p { max-width: 480px; margin: 0 0 30px; color: var(--muted); }
  .achievement-list { border-top: 1px solid var(--line-strong); }
  .achievement-list > div { min-height: 116px; display: grid; grid-template-columns: 74px 1fr auto; align-items: center; gap: 20px; border-bottom: 1px solid var(--line-strong); transition: 180ms ease; }
  .achievement-list > div:hover { padding-inline: 12px; background: rgba(139,188,255,.045); }
  .rank { color: var(--green); font-family: var(--mono); font-size: 1.5rem; }
  .achievement-list b { font-size: .95rem; }
  .achievement-list p { margin: 3px 0 0; color: var(--muted); font-size: .78rem; }
  .achievement-list em { color: #687c98; font-family: var(--mono); font-size: .68rem; font-style: normal; }

  .cta-section { margin-top: 120px; padding: 56px; display: flex; align-items: end; justify-content: space-between; gap: 40px; border: 1px solid var(--line-strong); background: linear-gradient(110deg, rgba(28,40,78,.96), rgba(8,14,27,.86)); clip-path: polygon(0 0, calc(100% - 34px) 0, 100% 34px, 100% 100%, 0 100%); }
  .cta-section h2 { margin: 12px 0 8px; font-size: clamp(1.8rem, 4vw, 3.4rem); letter-spacing: -.04em; }
  .cta-section p { margin: 0; color: var(--muted); }

  @keyframes pulse { 50% { opacity: .35; } }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes hover { 50% { transform: translateY(-8px) rotate(-1deg); } }
  @keyframes marquee { to { transform: translateX(-50%); } }

  @media (max-width: 1000px) {
    .home-hero { grid-template-columns: 1fr; padding-top: 72px; }
    .hero-copy { max-width: 760px; }
    .hero-visual { max-width: 650px; width: 100%; margin: auto; }
    .research-grid { grid-template-columns: repeat(2, 1fr); }
    .achievement-section { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .home-hero { min-height: auto; padding-block: 58px 54px; gap: 48px; }
    .hero-copy h1 { font-size: clamp(2.85rem, 15vw, 4.4rem); }
    .hero-actions { align-items: stretch; flex-direction: column; }
    .hero-actions a { width: 100%; }
    .hero-meta { gap: 28px; }
    .terminal-body { min-height: 410px; padding: 18px; }
    .logo-core { width: 250px; height: 250px; }
    .core-ring { width: 174px; height: 174px; }
    .core-ring img { width: 140px; height: 140px; }
    .terminal-status span:first-child { display: none; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats div:nth-child(2) { border-right: 0; }
    .stats div { padding: 23px 14px; }
    .research-section, .latest-section, .achievement-section { padding-top: 88px; }
    .research-grid, .post-grid { grid-template-columns: 1fr; }
    .research-card { min-height: 330px; }
    .achievement-list > div { grid-template-columns: 56px 1fr auto; gap: 10px; }
    .cta-section { margin-top: 90px; padding: 36px 24px; align-items: flex-start; flex-direction: column; }
  }
</style>
